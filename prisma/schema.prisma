// =============================================================
// Prisma schema — KARRALI POS
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// PHASE 1 — AUTH
// =============================================================

model User {
  Id             String    @id @default(uuid()) @db.Uuid
  Username       String    @unique
  PasswordHash   String
  FullName       String?
  Email          String?   @unique
  IsActive       Boolean   @default(true)
  SessionVersion Int       @default(0)
  LastLogin      DateTime? @db.Timestamptz(6)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Sessions        Session[]
  UserRoles       UserRole[]
  Sales           Sale[]        @relation("SaleCashier")
  CashierSessions CashSession[] @relation("CashierSessions")

  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Users")
}

model Role {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String  @unique
  Description String?
  IsSystem    Boolean @default(false)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  RolePermissions RolePermission[]
  UserRoles       UserRole[]

  @@index([DeletedAt])
  @@map("Roles")
}

model Permission {
  Id          String   @id @default(uuid()) @db.Uuid
  Code        String   @unique
  Description String?
  CreatedAt   DateTime @default(now()) @db.Timestamptz(6)

  RolePermissions RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  Id              String   @id @default(uuid()) @db.Uuid
  RoleId          String   @db.Uuid
  PermissionId    String   @db.Uuid
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Role       Role       @relation(fields: [RoleId], references: [Id], onDelete: Cascade)
  Permission Permission @relation(fields: [PermissionId], references: [Id], onDelete: Cascade)

  @@unique([RoleId, PermissionId])
  @@index([RoleId])
  @@index([PermissionId])
  @@map("RolePermissions")
}

model UserRole {
  Id              String   @id @default(uuid()) @db.Uuid
  UserId          String   @db.Uuid
  RoleId          String   @db.Uuid
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  User User @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  Role Role @relation(fields: [RoleId], references: [Id], onDelete: Cascade)

  @@unique([UserId, RoleId])
  @@index([UserId])
  @@index([RoleId])
  @@map("UserRoles")
}

model Session {
  Id               String    @id @default(uuid()) @db.Uuid
  UserId           String    @db.Uuid
  RefreshTokenHash String
  UserAgent        String?
  Ip               String?
  ExpiresAt        DateTime  @db.Timestamptz(6)
  RevokedAt        DateTime? @db.Timestamptz(6)
  LastUsedAt       DateTime? @db.Timestamptz(6)
  CreatedAt        DateTime  @default(now()) @db.Timestamptz(6)

  User User @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@index([UserId])
  @@index([ExpiresAt])
  @@index([RevokedAt])
  @@map("Sessions")
}

model AuditLog {
  Id        String   @id @default(uuid()) @db.Uuid
  UserId    String?  @db.Uuid
  Action    String
  Entity    String?
  EntityId  String?  @db.Uuid
  Before    Json?
  After     Json?
  Metadata  Json?
  Ip        String?
  UserAgent String?
  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([UserId])
  @@index([Action])
  @@index([Entity, EntityId])
  @@index([CreatedAt])
  @@map("AuditLogs")
}

// =============================================================
// PHASE 2a — CATALOG INFRASTRUCTURE
// =============================================================

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model Warehouse {
  Id        String  @id @default(uuid()) @db.Uuid
  Name      String
  Code      String  @unique
  Address   String?
  IsActive  Boolean @default(true)
  IsDefault Boolean @default(false)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Terminals       Terminal[]
  WarehouseStocks WarehouseStock[]
  StockMovements  StockMovement[]
  Purchases       Purchase[]
  Sales           Sale[]

  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Warehouses")
}

model Terminal {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Code        String  @unique
  WarehouseId String  @db.Uuid
  IsActive    Boolean @default(true)

  CreatedAt       DateTime      @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime?     @db.Timestamptz(6)
  CreatedByUserId String?       @db.Uuid
  UpdatedByUserId String?       @db.Uuid
  Sales           Sale[]
  CashSessions    CashSession[]

  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@index([WarehouseId])
  @@map("Terminals")
}

model Setting {
  Key             String   @id
  Value           Json
  Description     String?
  UpdatedAt       DateTime @updatedAt @db.Timestamptz(6)
  UpdatedByUserId String?  @db.Uuid

  @@map("Settings")
}

model Category {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Description String?
  ParentId    String? @db.Uuid
  IsActive    Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Parent   Category?  @relation("CategoryTree", fields: [ParentId], references: [Id], onDelete: SetNull)
  Children Category[] @relation("CategoryTree")
  Products Product[]

  @@index([ParentId])
  @@index([DeletedAt])
  @@map("Categories")
}

model Brand {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String  @unique
  Description String?
  IsActive    Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Products Product[]

  @@index([DeletedAt])
  @@map("Brands")
}

model Product {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Barcode     String? @unique
  SKU         String? @unique
  Description String?
  Unit        String  @default("pcs")

  Price     Decimal  @db.Decimal(18, 4)
  CostPrice Decimal  @db.Decimal(18, 4)
  Discount  Decimal  @default(0) @db.Decimal(18, 4)
  TaxRate   Decimal? @db.Decimal(5, 2)

  ReorderLevel   Int     @default(0)
  WarrantyMonths Int?    @default(0)
  ImageUrl       String?
  IsActive       Boolean @default(true)

  CategoryId String  @db.Uuid
  BrandId    String? @db.Uuid

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Category        Category         @relation(fields: [CategoryId], references: [Id], onDelete: Restrict)
  Brand           Brand?           @relation(fields: [BrandId], references: [Id], onDelete: SetNull)
  WarehouseStocks WarehouseStock[]
  StockMovements  StockMovement[]
  PurchaseItems   PurchaseItem[]
  SaleItems       SaleItem[]
  SaleReturnItems SaleReturnItem[]
  QuotationItems  QuotationItem[]

  @@index([CategoryId])
  @@index([BrandId])
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Products")
}

model WarehouseStock {
  Id          String @id @default(uuid()) @db.Uuid
  ProductId   String @db.Uuid
  WarehouseId String @db.Uuid
  Qty         Int    @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz(6)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(6)

  Product   Product   @relation(fields: [ProductId], references: [Id], onDelete: Cascade)
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@unique([ProductId, WarehouseId])
  @@index([ProductId])
  @@index([WarehouseId])
  @@map("WarehouseStocks")
}

model StockMovement {
  Id          String            @id @default(uuid()) @db.Uuid
  ProductId   String            @db.Uuid
  WarehouseId String            @db.Uuid
  Type        StockMovementType

  // Sign convention:
  //   positive = into warehouse (PURCHASE, SALE_RETURN, OPENING, TRANSFER_IN)
  //   negative = out of warehouse (SALE, PURCHASE_RETURN, TRANSFER_OUT)
  //   ADJUSTMENT uses whichever sign matches the correction.
  Quantity Int
  UnitCost Decimal? @db.Decimal(18, 4)
  Notes    String?

  // Reference IDs — plain UUIDs today; FKs added when Sale/Purchase
  // models land in later phases.
  SaleId       String? @db.Uuid
  SaleReturnId String? @db.Uuid
  PurchaseId   String? @db.Uuid

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Product   Product   @relation(fields: [ProductId], references: [Id], onDelete: Restrict)
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@index([ProductId])
  @@index([WarehouseId])
  @@index([Type])
  @@index([SaleId])
  @@index([SaleReturnId])
  @@index([PurchaseId])
  @@index([CreatedAt])
  @@index([ProductId, CreatedAt])
  @@index([Type, CreatedAt])
  @@map("StockMovements")
}

// =============================================================
// PHASE 2c — CUSTOMERS + SUPPLIERS
// =============================================================

enum CustomerType {
  RETAIL
  WHOLESALE
  CORPORATE
  VIP
  GOVERNMENT
  EDUCATIONAL
}

enum CustomerLedgerType {
  OPENING
  SALE
  SALE_RETURN
  PAYMENT
  PAYMENT_REVERSED
  CHEQUE
  CHEQUE_BOUNCED
  CHEQUE_VOIDED
  ADJUSTMENT
  WRITE_OFF
}

enum CreditPaymentMethod {
  CASH
  CHEQUE
}

model CodeSequence {
  Prefix     String   @id
  LastNumber Int      @default(0)
  UpdatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("CodeSequences")
}

model Customer {
  Id   String       @id @default(uuid()) @db.Uuid
  Code String       @unique // CUST-00001, service-generated
  Name String
  Type CustomerType @default(RETAIL)

  Phone     String? // indexed, not unique — walk-ins share numbers
  Email     String? // indexed, not unique — families share addresses
  Address   String?
  TaxNumber String?

  Balance Decimal @default(0) @db.Decimal(18, 4)

  CreditLimit  Decimal @default(0) @db.Decimal(18, 4)
  PaymentTerms String? // free-form for now ("Net 30", "Due on receipt")

  // Loyalty — columns reserved; engine lands in Phase 7.
  LoyaltyPoints  Int     @default(0)
  LoyaltyTier    String?
  LifetimeEarned Int     @default(0)

  Notes    String?
  IsActive Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  LedgerEntries       CustomerLedger[]
  Sales               Sale[]
  SaleReturns         SaleReturn[]
  CustomerCheques     CustomerCheque[]
  CreditPayments      CreditPayment[]
  Quotations          Quotation[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([Name])
  @@index([Phone])
  @@index([Email])
  @@index([Type])
  @@index([Balance]) // aging reports filter on non-zero balances
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Customers")
}

model CustomerLedger {
  Id         String             @id @default(uuid()) @db.Uuid
  CustomerId String             @db.Uuid
  Type       CustomerLedgerType

  Amount       Decimal @db.Decimal(18, 4) // signed
  BalanceAfter Decimal @db.Decimal(18, 4) // running snapshot
  Notes        String?

  SaleId          String? @db.Uuid
  SaleReturnId    String? @db.Uuid
  CreditPaymentId String? @db.Uuid
  ChequeId        String? @db.Uuid

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Customer Customer @relation(fields: [CustomerId], references: [Id], onDelete: Restrict)

  @@index([CustomerId])
  @@index([Type])
  @@index([CreatedAt])
  @@index([SaleId])
  @@index([CreditPaymentId])
  @@index([CustomerId, CreatedAt])
  @@map("CustomerLedgers")
}

model Supplier {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // SUP-00001, service-generated
  Name String

  Phone     String?
  Email     String?
  Address   String?
  TaxNumber String?

  PaymentTerms String? // free-form ("Net 30", "COD")

  // Bank details — one supplier, one account. Column approach, not a table.
  BankName      String?
  BankAccountNo String?
  BankBranch    String?
  BankSwift     String?

  Notes    String?
  IsActive Boolean @default(true)

  CreatedAt       DateTime          @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime?         @db.Timestamptz(6)
  CreatedByUserId String?           @db.Uuid
  UpdatedByUserId String?           @db.Uuid
  Purchases       Purchase[]
  Payments        SupplierPayment[]
  Cheques         SupplierCheque[]

  @@index([Name])
  @@index([Phone])
  @@index([Email])
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Suppliers")
}

// =============================================================
// PHASE 3 — PURCHASES + SUPPLIER PAYMENTS + SUPPLIER CHEQUES
// =============================================================

enum PurchaseStatus {
  POSTED
  CANCELLED
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum SupplierChequeStatus {
  PENDING // issued, waiting to clear
  CLEARED // cleared — SupplierPayment created
  BOUNCED // bounced — no payment
  VOIDED // cancelled before clearing
}

model Purchase {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // PUR-00001

  SupplierId        String    @db.Uuid
  SupplierInvoiceNo String? // supplier's own invoice number
  InvoiceDate       DateTime  @db.Timestamptz(6)
  DueDate           DateTime? @db.Timestamptz(6)
  WarehouseId       String    @db.Uuid

  Status PurchaseStatus @default(POSTED)

  Subtotal    Decimal @db.Decimal(18, 4) // sum of LineSubtotal
  TaxAmount   Decimal @default(0) @db.Decimal(18, 4) // sum of LineTax
  TotalAmount Decimal @db.Decimal(18, 4) // Subtotal + TaxAmount
  PaidAmount  Decimal @default(0) @db.Decimal(18, 4) // cache of payments

  Notes String?

  CreatedAt         DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt         DateTime? @db.Timestamptz(6)
  CreatedByUserId   String?   @db.Uuid
  UpdatedByUserId   String?   @db.Uuid
  CancelledAt       DateTime? @db.Timestamptz(6)
  CancelledByUserId String?   @db.Uuid

  Supplier  Supplier  @relation(fields: [SupplierId], references: [Id], onDelete: Restrict)
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  Items    PurchaseItem[]
  Payments SupplierPayment[]
  Cheques  SupplierCheque[]

  @@index([SupplierId])
  @@index([WarehouseId])
  @@index([Status])
  @@index([InvoiceDate])
  @@index([DueDate]) // AP aging
  @@index([CreatedAt])
  @@index([Status, DueDate])
  @@map("Purchases")
}

model PurchaseItem {
  Id         String @id @default(uuid()) @db.Uuid
  PurchaseId String @db.Uuid
  ProductId  String @db.Uuid

  Qty      Int
  UnitCost Decimal  @db.Decimal(18, 4)
  TaxRate  Decimal? @db.Decimal(5, 2) // %

  LineSubtotal Decimal @db.Decimal(18, 4) // Qty * UnitCost
  LineTax      Decimal @default(0) @db.Decimal(18, 4)
  LineTotal    Decimal @db.Decimal(18, 4) // Subtotal + Tax

  Notes String?

  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  Purchase Purchase @relation(fields: [PurchaseId], references: [Id], onDelete: Cascade)
  Product  Product  @relation(fields: [ProductId], references: [Id], onDelete: Restrict)

  @@index([PurchaseId])
  @@index([ProductId])
  @@map("PurchaseItems")
}

model SupplierPayment {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // PAY-00001

  SupplierId String                @db.Uuid
  PurchaseId String                @db.Uuid // single-purchase payments (D4)
  Method     SupplierPaymentMethod
  Amount     Decimal               @db.Decimal(18, 4)
  PaidAt     DateTime              @db.Timestamptz(6)

  // Only set when Method = CHEQUE and the cheque has cleared.
  ChequeId String? @unique @db.Uuid

  Notes String?

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime @updatedAt @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid
  UpdatedByUserId String?  @db.Uuid

  Supplier Supplier        @relation(fields: [SupplierId], references: [Id], onDelete: Restrict)
  Purchase Purchase        @relation(fields: [PurchaseId], references: [Id], onDelete: Restrict)
  Cheque   SupplierCheque? @relation("PaymentCheque", fields: [ChequeId], references: [Id], onDelete: SetNull)

  @@index([SupplierId])
  @@index([PurchaseId])
  @@index([Method])
  @@index([PaidAt])
  @@map("SupplierPayments")
}

model SupplierCheque {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // CHQ-00001

  SupplierId   String  @db.Uuid
  PurchaseId   String  @db.Uuid
  ChequeNumber String // physical cheque number, user-entered
  BankName     String? // our bank (Phase 5 will link to BankAccount)
  Amount       Decimal @db.Decimal(18, 4)

  IssueDate DateTime @db.Timestamptz(6)
  DueDate   DateTime @db.Timestamptz(6) // when to present

  Status       SupplierChequeStatus @default(PENDING)
  ClearedAt    DateTime?            @db.Timestamptz(6)
  BouncedAt    DateTime?            @db.Timestamptz(6)
  BounceReason String?

  Notes String?

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime @updatedAt @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid
  UpdatedByUserId String?  @db.Uuid

  Supplier Supplier         @relation(fields: [SupplierId], references: [Id], onDelete: Restrict)
  Purchase Purchase         @relation(fields: [PurchaseId], references: [Id], onDelete: Restrict)
  Payment  SupplierPayment? @relation("PaymentCheque")

  @@index([SupplierId])
  @@index([PurchaseId])
  @@index([Status])
  @@index([DueDate]) // cheque calendar (Phase 6)
  @@index([ChequeNumber])
  @@map("SupplierCheques")
}

// =============================================================
// PHASE 4 — SALES, RETURNS, CREDIT PAYMENTS, CUSTOMER CHEQUES, CASH
// =============================================================
enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  FULLY_RETURNED
  CANCELLED
}

enum SalePaymentMethod {
  CASH
  CARD
  CREDIT
  CHEQUE
}

enum SaleReturnRefundMethod {
  CASH // drawer -Amount
  CREDIT // customer balance -Amount (may go negative = store credit)
}

enum CustomerChequeStatus {
  PENDING
  CLEARED
  BOUNCED
  VOIDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashLedgerType {
  SALE // cash portion of a sale
  SALE_REFUND // cash refund on a return or cancel
  CREDIT_PAYMENT // customer paid down credit with cash
  CREDIT_PAYMENT_REVERSED
  CASH_IN // manual entry
  CASH_OUT // manual entry
  EXPENSE // Phase 5
  EXPENSE_REVERSED
  BANK_DEPOSIT // moving cash out to bank
}

model Sale {
  Id            String @id @default(uuid()) @db.Uuid
  InvoiceNumber String @unique // e.g. MAIN-01-000001, per-terminal

  TerminalId  String  @db.Uuid
  WarehouseId String  @db.Uuid
  CashierId   String  @db.Uuid
  CustomerId  String? @db.Uuid // null = walk-in

  Subtotal              Decimal @db.Decimal(18, 4)
  DiscountAmount        Decimal @default(0) @db.Decimal(18, 4)
  TaxAmount             Decimal @default(0) @db.Decimal(18, 4)
  TotalAmount           Decimal @db.Decimal(18, 4)
  // Cached payment split — source of truth is SalePayments, but these
  // make payment-method reports a single-index scan.
  CashAmount            Decimal @default(0) @db.Decimal(18, 4)
  CardAmount            Decimal @default(0) @db.Decimal(18, 4)
  CreditAmount          Decimal @default(0) @db.Decimal(18, 4)
  ChequeAmount          Decimal @default(0) @db.Decimal(18, 4)
  // Loyalty — snapshot at sale time
  LoyaltyEarnedPoints   Int     @default(0)
  LoyaltyRedeemedPoints Int     @default(0)
  LoyaltyDiscountAmount Decimal @default(0) @db.Decimal(18, 4)
  LoyaltyReversedPoints Int     @default(0) // earned points clawed back (cancel or return)

  PaidAmount     Decimal @default(0) @db.Decimal(18, 4) // cash + card + credit-paid
  RefundedAmount Decimal @default(0) @db.Decimal(18, 4) // sum of SaleReturn totals

  Status            SaleStatus @default(COMPLETED)
  Notes             String?
  CancelledAt       DateTime?  @db.Timestamptz(6)
  CancelledByUserId String?    @db.Uuid
  CancelReason      String?

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Terminal  Terminal   @relation(fields: [TerminalId], references: [Id], onDelete: Restrict)
  Warehouse Warehouse  @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)
  Cashier   User       @relation("SaleCashier", fields: [CashierId], references: [Id], onDelete: Restrict)
  Customer  Customer?  @relation(fields: [CustomerId], references: [Id], onDelete: SetNull)
  Quotation Quotation? @relation("QuotationConversion")

  Items    SaleItem[]
  Payments SalePayment[]
  Returns  SaleReturn[]
  Cheques  CustomerCheque[]

  @@index([TerminalId])
  @@index([WarehouseId])
  @@index([CashierId])
  @@index([CustomerId])
  @@index([Status])
  @@index([CreatedAt])
  @@index([CashAmount])
  @@index([CardAmount])
  @@index([CreditAmount])
  @@index([ChequeAmount])
  @@index([Status, CreatedAt])
  @@index([TerminalId, CreatedAt])
  @@index([CustomerId, CreatedAt])
  @@map("Sales")
}

model SaleItem {
  Id        String @id @default(uuid()) @db.Uuid
  SaleId    String @db.Uuid
  ProductId String @db.Uuid

  Qty       Int
  UnitPrice Decimal  @db.Decimal(18, 4)
  Discount  Decimal  @default(0) @db.Decimal(18, 4) // % off line
  TaxRate   Decimal? @db.Decimal(5, 2)

  LineSubtotal Decimal @db.Decimal(18, 4) // Qty * UnitPrice
  LineDiscount Decimal @default(0) @db.Decimal(18, 4)
  LineTax      Decimal @default(0) @db.Decimal(18, 4)
  LineTotal    Decimal @db.Decimal(18, 4)

  ReturnedQty Int @default(0) // cache; validated against Qty on return

  Notes     String?
  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  Sale        Sale             @relation(fields: [SaleId], references: [Id], onDelete: Cascade)
  Product     Product          @relation(fields: [ProductId], references: [Id], onDelete: Restrict)
  ReturnItems SaleReturnItem[]

  @@index([SaleId])
  @@index([ProductId])
  @@map("SaleItems")
}

model SalePayment {
  Id     String            @id @default(uuid()) @db.Uuid
  SaleId String            @db.Uuid
  Method SalePaymentMethod
  Amount Decimal           @db.Decimal(18, 4) // always positive

  // Set only when Method = CHEQUE. Unique — a cheque maps to one payment.
  ChequeId String? @unique @db.Uuid

  // Set when the payment was reversed (cheque bounced/voided on a cheque
  // payment; partial cancellation on a cash payment — future).
  ReversedAt       DateTime? @db.Timestamptz(6)
  ReversedByUserId String?   @db.Uuid
  ReversalReason   String?

  Notes           String?
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Sale   Sale            @relation(fields: [SaleId], references: [Id], onDelete: Cascade)
  Cheque CustomerCheque? @relation("SalePaymentCheque", fields: [ChequeId], references: [Id], onDelete: SetNull)

  @@index([SaleId])
  @@index([Method])
  @@index([ReversedAt])
  @@index([Method, CreatedAt])
  @@map("SalePayments")
}

model SaleReturn {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // RET-00001

  SaleId     String  @db.Uuid
  CustomerId String? @db.Uuid // copied from sale

  RefundMethod SaleReturnRefundMethod
  Subtotal     Decimal                @db.Decimal(18, 4)
  TaxAmount    Decimal                @default(0) @db.Decimal(18, 4)
  RefundAmount Decimal                @db.Decimal(18, 4) // = Subtotal + TaxAmount

  Notes String?

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Sale     Sale             @relation(fields: [SaleId], references: [Id], onDelete: Restrict)
  Customer Customer?        @relation(fields: [CustomerId], references: [Id], onDelete: SetNull)
  Items    SaleReturnItem[]

  @@index([SaleId])
  @@index([CustomerId])
  @@index([CreatedAt])
  @@map("SaleReturns")
}

model SaleReturnItem {
  Id           String @id @default(uuid()) @db.Uuid
  SaleReturnId String @db.Uuid
  SaleItemId   String @db.Uuid
  ProductId    String @db.Uuid

  Qty       Int // positive; added back to stock
  UnitPrice Decimal  @db.Decimal(18, 4) // snapshot from SaleItem
  TaxRate   Decimal? @db.Decimal(5, 2)

  LineSubtotal Decimal @db.Decimal(18, 4)
  LineTax      Decimal @default(0) @db.Decimal(18, 4)
  RefundAmount Decimal @db.Decimal(18, 4) // = Subtotal + Tax

  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  SaleReturn SaleReturn @relation(fields: [SaleReturnId], references: [Id], onDelete: Cascade)
  SaleItem   SaleItem   @relation(fields: [SaleItemId], references: [Id], onDelete: Restrict)
  Product    Product    @relation(fields: [ProductId], references: [Id], onDelete: Restrict)

  @@index([SaleReturnId])
  @@index([SaleItemId])
  @@index([ProductId])
  @@map("SaleReturnItems")
}

model CustomerCheque {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // RCHQ-00001

  CustomerId String  @db.Uuid
  SaleId     String? @db.Uuid // optional link — a cheque may cover several sales or pure debt

  ChequeNumber String
  BankName     String?
  BankBranch   String?
  Amount       Decimal @db.Decimal(18, 4)

  IssueDate DateTime @db.Timestamptz(6)
  DueDate   DateTime @db.Timestamptz(6) // for the "cheques due" calendar

  Status       CustomerChequeStatus @default(PENDING)
  ClearedAt    DateTime?            @db.Timestamptz(6)
  BouncedAt    DateTime?            @db.Timestamptz(6)
  BounceReason String?

  Notes String?

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Customer      Customer       @relation(fields: [CustomerId], references: [Id], onDelete: Restrict)
  Sale          Sale?          @relation(fields: [SaleId], references: [Id], onDelete: SetNull)
  SalePayment   SalePayment?   @relation("SalePaymentCheque")
  CreditPayment CreditPayment? @relation("CreditPaymentCheque")

  @@index([CustomerId])
  @@index([SaleId])
  @@index([Status])
  @@index([DueDate])
  @@index([ChequeNumber])
  @@map("CustomerCheques")
}

model CreditPayment {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // CPAY-00001

  CustomerId String              @db.Uuid
  Method     CreditPaymentMethod
  Amount     Decimal             @db.Decimal(18, 4) // positive

  PaidAt DateTime @db.Timestamptz(6)

  // Set only when Method = CHEQUE.
  ChequeId String? @unique @db.Uuid

  // Set when reversed (cheque bounced/voided).
  ReversedAt       DateTime? @db.Timestamptz(6)
  ReversedByUserId String?   @db.Uuid
  ReversalReason   String?

  Notes           String?
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Customer Customer        @relation(fields: [CustomerId], references: [Id], onDelete: Restrict)
  Cheque   CustomerCheque? @relation("CreditPaymentCheque", fields: [ChequeId], references: [Id], onDelete: SetNull)

  @@index([CustomerId])
  @@index([Method])
  @@index([PaidAt])
  @@index([ReversedAt])
  @@map("CreditPayments")
}

model CashSession {
  Id String @id @default(uuid()) @db.Uuid

  TerminalId String @db.Uuid
  CashierId  String @db.Uuid

  OpenedAt     DateTime @db.Timestamptz(6)
  StartingCash Decimal  @db.Decimal(18, 4)

  ClosedAt     DateTime? @db.Timestamptz(6)
  CountedCash  Decimal?  @db.Decimal(18, 4)
  ExpectedCash Decimal?  @db.Decimal(18, 4) // snapshot at close
  Difference   Decimal?  @db.Decimal(18, 4) // Counted − Expected

  Status CashSessionStatus @default(OPEN)
  Notes  String?

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  ClosedByUserId  String?  @db.Uuid
  CreatedByUserId String?  @db.Uuid

  Terminal  Terminal       @relation(fields: [TerminalId], references: [Id], onDelete: Restrict)
  Cashier   User           @relation("CashierSessions", fields: [CashierId], references: [Id], onDelete: Restrict)
  Entries   CashLedger[]
  Movements CashMovement[]

  @@index([TerminalId])
  @@index([CashierId])
  @@index([Status])
  @@index([OpenedAt])
  @@map("CashSessions")
}

model CashLedger {
  Id String @id @default(uuid()) @db.Uuid

  CashSessionId String? @db.Uuid // nullable — supports un-sessioned entries

  Type   CashLedgerType
  Amount Decimal        @db.Decimal(18, 4) // signed

  // Reference to the source entity (whichever applies)
  SaleId           String? @db.Uuid
  SaleReturnId     String? @db.Uuid
  CreditPaymentId  String? @db.Uuid
  CustomerChequeId String? @db.Uuid
  ExpenseId        String? @db.Uuid

  Notes           String?
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  CashSession CashSession? @relation(fields: [CashSessionId], references: [Id], onDelete: SetNull)

  @@index([CashSessionId])
  @@index([Type])
  @@index([CreatedAt])
  @@index([SaleId])
  @@index([SaleReturnId])
  @@index([CreditPaymentId])
  @@index([Type, CreatedAt])
  @@map("CashLedgers")
}

// =============================================================
// PHASE 5 — BANK ACCOUNTS, EXPENSE CATEGORIES, EXPENSES, CASH MOVEMENTS
// =============================================================

enum ExpensePaymentMethod {
  CASH
  BANK
}

enum CashMovementType {
  CASH_IN // cash added to drawer
  CASH_OUT // cash removed from drawer
}

model BankAccount {
  Id            String  @id @default(uuid()) @db.Uuid
  Name          String // our label: "Operating Account"
  BankName      String // "Commercial Bank"
  AccountNumber String  @unique
  Branch        String?
  Swift         String?
  IsDefault     Boolean @default(false)
  IsActive      Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Expenses      Expense[]
  CashMovements CashMovement[]

  @@index([IsActive])
  @@index([DeletedAt])
  @@map("BankAccounts")
}

model ExpenseCategory {
  Id       String  @id @default(uuid()) @db.Uuid
  Name     String  @unique
  IsActive Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Expenses Expense[]

  @@index([DeletedAt])
  @@map("ExpenseCategories")
}

model Expense {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // EXP-00001

  CategoryId String @db.Uuid

  Amount        Decimal              @db.Decimal(18, 4) // always positive
  Method        ExpensePaymentMethod
  BankAccountId String?              @db.Uuid // required when Method = BANK

  Description String
  Payee       String? // free-form; may not be a registered Supplier
  PaidAt      DateTime @db.Timestamptz(6)

  Notes String?

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Category    ExpenseCategory @relation(fields: [CategoryId], references: [Id], onDelete: Restrict)
  BankAccount BankAccount?    @relation(fields: [BankAccountId], references: [Id], onDelete: Restrict)

  @@index([CategoryId])
  @@index([BankAccountId])
  @@index([Method])
  @@index([PaidAt])
  @@index([DeletedAt])
  @@index([Method, PaidAt])
  @@map("Expenses")
}

model CashMovement {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // CM-00001

  Type   CashMovementType
  Amount Decimal          @db.Decimal(18, 4) // always positive; direction via Type

  Reason String
  Notes  String?

  // Optional — set when this movement links drawer ↔ bank.
  //   CASH_IN  + BankAccountId = withdrawal from bank into drawer
  //   CASH_OUT + BankAccountId = deposit from drawer into bank
  // Null when it's a pure drawer movement (change fund, owner draw, etc.).
  BankAccountId String? @db.Uuid

  // Session link — nullable; close() attaches retroactively if null.
  CashSessionId String? @db.Uuid

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime @updatedAt @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid
  UpdatedByUserId String?  @db.Uuid

  BankAccount BankAccount? @relation(fields: [BankAccountId], references: [Id], onDelete: Restrict)
  CashSession CashSession? @relation(fields: [CashSessionId], references: [Id], onDelete: SetNull)

  @@index([Type])
  @@index([BankAccountId])
  @@index([CashSessionId])
  @@index([CreatedAt])
  @@map("CashMovements")
}

// =============================================================
// PHASE 7 — QUOTATIONS
// =============================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
}

model Quotation {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // QUO-00001

  CustomerId String? @db.Uuid // null = walk-in quote

  Status QuotationStatus @default(DRAFT)

  Subtotal       Decimal @db.Decimal(18, 4)
  DiscountAmount Decimal @default(0) @db.Decimal(18, 4)
  TaxAmount      Decimal @default(0) @db.Decimal(18, 4)
  TotalAmount    Decimal @db.Decimal(18, 4)

  ValidUntil DateTime? @db.Timestamptz(6)
  Notes      String?

  // Set when the quote is converted to a Sale.
  SaleId            String?   @unique @db.Uuid
  ConvertedAt       DateTime? @db.Timestamptz(6)
  ConvertedByUserId String?   @db.Uuid

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Customer Customer? @relation(fields: [CustomerId], references: [Id], onDelete: SetNull)
  Sale     Sale?     @relation("QuotationConversion", fields: [SaleId], references: [Id], onDelete: SetNull)

  Items QuotationItem[]

  @@index([CustomerId])
  @@index([Status])
  @@index([ValidUntil])
  @@index([CreatedAt])
  @@index([DeletedAt])
  @@map("Quotations")
}

model QuotationItem {
  Id          String @id @default(uuid()) @db.Uuid
  QuotationId String @db.Uuid
  ProductId   String @db.Uuid

  Qty       Int
  UnitPrice Decimal  @db.Decimal(18, 4)
  Discount  Decimal  @default(0) @db.Decimal(18, 4) // % off line
  TaxRate   Decimal? @db.Decimal(5, 2)

  LineSubtotal Decimal @db.Decimal(18, 4) // Qty * UnitPrice
  LineDiscount Decimal @default(0) @db.Decimal(18, 4)
  LineTax      Decimal @default(0) @db.Decimal(18, 4)
  LineTotal    Decimal @db.Decimal(18, 4) // Subtotal - Discount + Tax

  Notes String?

  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  Quotation Quotation @relation(fields: [QuotationId], references: [Id], onDelete: Cascade)
  Product   Product   @relation(fields: [ProductId], references: [Id], onDelete: Restrict)

  @@index([QuotationId])
  @@index([ProductId])
  @@map("QuotationItems")
}

// =============================================================
// PHASE 7c — LOYALTY
// =============================================================

enum LoyaltyTransactionType {
  EARN // customer earned points from a sale
  REDEEM // customer spent points at checkout
  ADJUST // manual admin adjustment
  REVERSAL // points clawed back (sale cancel, partial return)
}

model LoyaltyTransaction {
  Id         String                 @id @default(uuid()) @db.Uuid
  CustomerId String                 @db.Uuid
  Type       LoyaltyTransactionType

  /**
   * Signed. EARN/up-adjust positive, REDEEM/down-adjust/reversal-of-earn negative.
   */
  Points      Int
  /**
   * Running total immediately after this transaction.
   */
  PointsAfter Int

  SaleId       String? @db.Uuid
  SaleReturnId String? @db.Uuid
  /**
   * Set when this txn is reversing an earlier one (cancel, return).
   */
  ReversalOfId String? @db.Uuid

  Notes String?

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Customer Customer @relation(fields: [CustomerId], references: [Id], onDelete: Restrict)

  @@index([CustomerId])
  @@index([Type])
  @@index([CreatedAt])
  @@index([SaleId])
  @@index([ReversalOfId])
  @@map("LoyaltyTransactions")
}
