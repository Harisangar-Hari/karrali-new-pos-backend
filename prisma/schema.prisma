// =============================================================
// Prisma schema — KARRALI POS
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// PHASE 1 — AUTH
// =============================================================

model User {
  Id             String    @id @default(uuid()) @db.Uuid
  Username       String    @unique
  PasswordHash   String
  FullName       String?
  Email          String?   @unique
  IsActive       Boolean   @default(true)
  SessionVersion Int       @default(0)
  LastLogin      DateTime? @db.Timestamptz(6)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Sessions  Session[]
  UserRoles UserRole[]

  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Users")
}

model Role {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String  @unique
  Description String?
  IsSystem    Boolean @default(false)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  RolePermissions RolePermission[]
  UserRoles       UserRole[]

  @@index([DeletedAt])
  @@map("Roles")
}

model Permission {
  Id          String   @id @default(uuid()) @db.Uuid
  Code        String   @unique
  Description String?
  CreatedAt   DateTime @default(now()) @db.Timestamptz(6)

  RolePermissions RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  Id              String   @id @default(uuid()) @db.Uuid
  RoleId          String   @db.Uuid
  PermissionId    String   @db.Uuid
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Role       Role       @relation(fields: [RoleId], references: [Id], onDelete: Cascade)
  Permission Permission @relation(fields: [PermissionId], references: [Id], onDelete: Cascade)

  @@unique([RoleId, PermissionId])
  @@index([RoleId])
  @@index([PermissionId])
  @@map("RolePermissions")
}

model UserRole {
  Id              String   @id @default(uuid()) @db.Uuid
  UserId          String   @db.Uuid
  RoleId          String   @db.Uuid
  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  User User @relation(fields: [UserId], references: [Id], onDelete: Cascade)
  Role Role @relation(fields: [RoleId], references: [Id], onDelete: Cascade)

  @@unique([UserId, RoleId])
  @@index([UserId])
  @@index([RoleId])
  @@map("UserRoles")
}

model Session {
  Id               String    @id @default(uuid()) @db.Uuid
  UserId           String    @db.Uuid
  RefreshTokenHash String
  UserAgent        String?
  Ip               String?
  ExpiresAt        DateTime  @db.Timestamptz(6)
  RevokedAt        DateTime? @db.Timestamptz(6)
  LastUsedAt       DateTime? @db.Timestamptz(6)
  CreatedAt        DateTime  @default(now()) @db.Timestamptz(6)

  User User @relation(fields: [UserId], references: [Id], onDelete: Cascade)

  @@index([UserId])
  @@index([ExpiresAt])
  @@index([RevokedAt])
  @@map("Sessions")
}

model AuditLog {
  Id        String   @id @default(uuid()) @db.Uuid
  UserId    String?  @db.Uuid
  Action    String
  Entity    String?
  EntityId  String?  @db.Uuid
  Before    Json?
  After     Json?
  Metadata  Json?
  Ip        String?
  UserAgent String?
  CreatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([UserId])
  @@index([Action])
  @@index([Entity, EntityId])
  @@index([CreatedAt])
  @@map("AuditLogs")
}

// =============================================================
// PHASE 2a — CATALOG INFRASTRUCTURE
// =============================================================

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model Warehouse {
  Id        String  @id @default(uuid()) @db.Uuid
  Name      String
  Code      String  @unique
  Address   String?
  IsActive  Boolean @default(true)
  IsDefault Boolean @default(false)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Terminals       Terminal[]
  WarehouseStocks WarehouseStock[]
  StockMovements  StockMovement[]

  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Warehouses")
}

model Terminal {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Code        String  @unique
  WarehouseId String  @db.Uuid
  IsActive    Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@index([WarehouseId])
  @@map("Terminals")
}

model Setting {
  Key             String   @id
  Value           Json
  Description     String?
  UpdatedAt       DateTime @updatedAt @db.Timestamptz(6)
  UpdatedByUserId String?  @db.Uuid

  @@map("Settings")
}

model Category {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Description String?
  ParentId    String? @db.Uuid
  IsActive    Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Parent   Category?  @relation("CategoryTree", fields: [ParentId], references: [Id], onDelete: SetNull)
  Children Category[] @relation("CategoryTree")
  Products Product[]

  @@index([ParentId])
  @@index([DeletedAt])
  @@map("Categories")
}

model Brand {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String  @unique
  Description String?
  IsActive    Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Products Product[]

  @@index([DeletedAt])
  @@map("Brands")
}

model Product {
  Id          String  @id @default(uuid()) @db.Uuid
  Name        String
  Barcode     String? @unique
  SKU         String? @unique
  Description String?
  Unit        String  @default("pcs")

  Price     Decimal  @db.Decimal(18, 4)
  CostPrice Decimal  @db.Decimal(18, 4)
  Discount  Decimal  @default(0) @db.Decimal(18, 4)
  TaxRate   Decimal? @db.Decimal(5, 2)

  ReorderLevel   Int     @default(0)
  WarrantyMonths Int?    @default(0)
  ImageUrl       String?
  IsActive       Boolean @default(true)

  CategoryId String  @db.Uuid
  BrandId    String? @db.Uuid

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  Category        Category         @relation(fields: [CategoryId], references: [Id], onDelete: Restrict)
  Brand           Brand?           @relation(fields: [BrandId], references: [Id], onDelete: SetNull)
  WarehouseStocks WarehouseStock[]
  StockMovements  StockMovement[]

  @@index([CategoryId])
  @@index([BrandId])
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Products")
}

model WarehouseStock {
  Id          String @id @default(uuid()) @db.Uuid
  ProductId   String @db.Uuid
  WarehouseId String @db.Uuid
  Qty         Int    @default(0)

  CreatedAt DateTime @default(now()) @db.Timestamptz(6)
  UpdatedAt DateTime @updatedAt @db.Timestamptz(6)

  Product   Product   @relation(fields: [ProductId], references: [Id], onDelete: Cascade)
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@unique([ProductId, WarehouseId])
  @@index([ProductId])
  @@index([WarehouseId])
  @@map("WarehouseStocks")
}

model StockMovement {
  Id          String            @id @default(uuid()) @db.Uuid
  ProductId   String            @db.Uuid
  WarehouseId String            @db.Uuid
  Type        StockMovementType

  // Sign convention:
  //   positive = into warehouse (PURCHASE, SALE_RETURN, OPENING, TRANSFER_IN)
  //   negative = out of warehouse (SALE, PURCHASE_RETURN, TRANSFER_OUT)
  //   ADJUSTMENT uses whichever sign matches the correction.
  Quantity Int
  UnitCost Decimal? @db.Decimal(18, 4)
  Notes    String?

  // Reference IDs — plain UUIDs today; FKs added when Sale/Purchase
  // models land in later phases.
  SaleId       String? @db.Uuid
  SaleReturnId String? @db.Uuid
  PurchaseId   String? @db.Uuid

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Product   Product   @relation(fields: [ProductId], references: [Id], onDelete: Restrict)
  Warehouse Warehouse @relation(fields: [WarehouseId], references: [Id], onDelete: Restrict)

  @@index([ProductId])
  @@index([WarehouseId])
  @@index([Type])
  @@index([SaleId])
  @@index([SaleReturnId])
  @@index([PurchaseId])
  @@index([CreatedAt])
  @@map("StockMovements")
}

// =============================================================
// PHASE 2c — CUSTOMERS + SUPPLIERS
// =============================================================

enum CustomerType {
  RETAIL
  WHOLESALE
  CORPORATE
  VIP
  GOVERNMENT
  EDUCATIONAL
}

enum CustomerLedgerType {
  OPENING
  SALE
  SALE_RETURN
  PAYMENT
  CHEQUE
  CHEQUE_BOUNCED
  ADJUSTMENT
  WRITE_OFF
}

model CodeSequence {
  Prefix     String   @id
  LastNumber Int      @default(0)
  UpdatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@map("CodeSequences")
}

model Customer {
  Id   String       @id @default(uuid()) @db.Uuid
  Code String       @unique // CUST-00001, service-generated
  Name String
  Type CustomerType @default(RETAIL)

  Phone     String? // indexed, not unique — walk-ins share numbers
  Email     String? // indexed, not unique — families share addresses
  Address   String?
  TaxNumber String?

  Balance Decimal @default(0) @db.Decimal(18, 4)

  CreditLimit  Decimal @default(0) @db.Decimal(18, 4)
  PaymentTerms String? // free-form for now ("Net 30", "Due on receipt")

  // Loyalty — columns reserved; engine lands in Phase 7.
  LoyaltyPoints Int     @default(0)
  LoyaltyTier   String?

  Notes    String?
  IsActive Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  LedgerEntries CustomerLedger[]

  @@index([Name])
  @@index([Phone])
  @@index([Email])
  @@index([Type])
  @@index([Balance]) // aging reports filter on non-zero balances
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Customers")
}

model CustomerLedger {
  Id         String             @id @default(uuid()) @db.Uuid
  CustomerId String             @db.Uuid
  Type       CustomerLedgerType

  Amount       Decimal @db.Decimal(18, 4) // signed
  BalanceAfter Decimal @db.Decimal(18, 4) // running snapshot
  Notes        String?

  SaleId          String? @db.Uuid
  SaleReturnId    String? @db.Uuid
  CreditPaymentId String? @db.Uuid
  ChequeId        String? @db.Uuid

  CreatedAt       DateTime @default(now()) @db.Timestamptz(6)
  CreatedByUserId String?  @db.Uuid

  Customer Customer @relation(fields: [CustomerId], references: [Id], onDelete: Restrict)

  @@index([CustomerId])
  @@index([Type])
  @@index([CreatedAt])
  @@index([SaleId])
  @@index([CreditPaymentId])
  @@map("CustomerLedgers")
}

model Supplier {
  Id   String @id @default(uuid()) @db.Uuid
  Code String @unique // SUP-00001, service-generated
  Name String

  Phone     String?
  Email     String?
  Address   String?
  TaxNumber String?

  PaymentTerms String? // free-form ("Net 30", "COD")

  // Bank details — one supplier, one account. Column approach, not a table.
  BankName      String?
  BankAccountNo String?
  BankBranch    String?
  BankSwift     String?

  Notes    String?
  IsActive Boolean @default(true)

  CreatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  UpdatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  DeletedAt       DateTime? @db.Timestamptz(6)
  CreatedByUserId String?   @db.Uuid
  UpdatedByUserId String?   @db.Uuid

  @@index([Name])
  @@index([Phone])
  @@index([Email])
  @@index([IsActive])
  @@index([DeletedAt])
  @@map("Suppliers")
}
